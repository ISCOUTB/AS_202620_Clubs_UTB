# Conexión a PostgreSQL (red interna de Dokploy o instancia local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/linkclub

# Secreto obligatorio para firmar y verificar tokens JWT (HS256)
JWT_SECRET=cambia-este-secreto-por-una-clave-larga-y-aleatoria

# Vigencia del token JWT en días (por defecto: 7)
JWT_EXPIRES_DAYS=7

# Orígenes permitidos para CORS separados por coma (sin comodín "*")
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Directorio local de almacenamiento de imágenes subidas
UPLOAD_DIR=uploads